        {
          "name": "TC-01 Đăng ký SV hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sv{{$timestamp}}@vanlanguni.vn\",\n  \"password\": \"Abc12345\",\n  \"fullName\": \"SV Postman\",\n  \"role\": \"STUDENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
